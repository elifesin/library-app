@model IEnumerable<Ee.Ebs.LaboratoryApp.Models.Book.BookListVm>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Laboratuvar Kitap Listesi</h2>
    </div>
    
    <hr />

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
            <tr>
                <th>Kitap Adı</th>
                <th>Yazarı</th>
                <th>Kategori</th>
                <th>Yayınevi</th>
                <th>Yayın Yılı</th>
                <th>Durum</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.FullName</td> 
                    <td>@item.CategoryName</td>
                    <td>@item.PublisherName</td>
                    <td>@item.PublishYear</td>
                    <td>
                        @if (item.IsBorrowed)
                        {
                            <span class="badge bg-danger">Ödünç Verildi</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Kütüphanede</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center" role="alert">
            Laboratuvar sisteminde henüz kayıtlı bir kitap bulunmamaktadır.
        </div>
    }
</div>