@model IEnumerable<LibraryApp.Models.Book.BookVm>

<div class="container mt-4">
    <h2>Kitap Listesi</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">Yeni Kitap Ekle</a>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
            <tr>
                <th>Kitap Adı</th>
                <th>Yazarı</th>
                <th>Ödünç Alındı Mı?</th>
                <th>Kategori</th>
                <th>Güncelle</th>
                <th>Sil</th>
            </tr>
            </thead>
            <tbody>
            -        @foreach (var item in Model)
                     {
                         <tr>
                             <td>@item.Title</td>
                             <td>@item.FullName</td> 
                             <td>@item.IsBorrowed</td> 
                             <td>@item.CategoryName</td>

                             <td>
                                 <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Güncelle</a>
                             </td>
                             <td>
                                 <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger ms-1">Sil</a>
                             </td>
                         </tr>
                     }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Veritabanında henüz kayıtlı bir yazar bulunmuyor. Yukarıdaki butonu kullanarak ilk kaydı ekleyebilirsiniz.
        </div>
    }
</div>

