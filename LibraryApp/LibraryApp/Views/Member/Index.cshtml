@model IEnumerable<LibraryApp.Models.Members.MemberVm>

<div class="container mt-4">
    <h2>Üye Sayfası</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">Üye Ol</a>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
            <tr>
                <th>İşlemler</th>
                <th>ID</th>
                <th>Üye Adı Soyadı</th>
            </tr>
            </thead>
            <tbody>
            -        @foreach (var item in Model)
                     {
                         <tr>
                             <td>
                                 <div class="dropdown">
                                     <!-- Dropdown'ı tetikleyen ana buton -->
                                     <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" id="dropdownMenuButton_@item.ID" data-bs-toggle="dropdown" aria-expanded="false">
                                         İşlemler
                                     </button>
        
                                     <!-- Açılır menü içindeki seçenekler -->
                                     <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton_@item.ID">
                                         <li>
                                             <!-- Güncelle/Düzenle linki -->
                                             <a class="dropdown-item text-primary" asp-action="Edit" asp-route-id="@item.ID">
                                                 <i class="bi bi-pencil"></i> Güncelle
                                             </a>
                                         </li>
                                         <li>
                                             <!-- Kitapları Gör linki (Sizin görselinizde 'Sil' altında bu yazıyordu) -->
                                             <a class="dropdown-item text-info" asp-action="BorrowedBooks" asp-route-id="@item.ID">
                                                 <i class="bi bi-book"></i> Kitapları Gör
                                             </a>
                                         </li>
                                         <li>
                                             <hr class="dropdown-divider">
                                         </li>
                                         <li>
                                             <!-- Sil linki -->
                                             <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.ID">
                                                 <i class="bi bi-trash"></i> Sil
                                             </a>
                                         </li>
                                     </ul>
                                 </div>
                             </td>
                             <td>@item.ID</td>
                             <td>@item.FirstName @item.LastName</td>
                             </tr>
                     }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Veritabanında henüz kayıtlı bir üye bulunmuyor. Yukarıdaki butonu kullanarak ilk kaydı ekleyebilirsiniz.
        </div>
    }
</div>




