@model IEnumerable<LibraryApp.Models.Publisher.PublisherVm>

@{
    ViewData["Title"] = "Yayınevleri";
}

<div class="container mt-4">
    <h2>Yayınevi Listesi</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Yeni Yayınevi Ekle</a>
    </p>
    
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Yayınevi Adı</th>
            <th>İşlemler</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>