@model IEnumerable<LibraryApp.Models.Publisher.PublisherVm>

@{
    ViewData["Title"] = "Yayınevleri";
}

<div class="container mt-4">
    <h2>Yayınevi Listesi</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Yeni Yayınevi Ekle</a>
    </p>
    
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>İşlemler</th>
            <th>ID</th>
            <th>Yayınevi Adı</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" id="dropdownMenuButton_@item.Id" data-bs-toggle="dropdown" aria-expanded="false">
                            İşlemler
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton_@item.Id">
                            <li>
                                <a class="dropdown-item text-primary" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="bi bi-pencil"></i> Güncelle
                                </a>
                            </li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>
                <td>@item.Id</td>
                <td>@item.Name</td>
            </tr>
        }
        </tbody>
    </table>
</div>