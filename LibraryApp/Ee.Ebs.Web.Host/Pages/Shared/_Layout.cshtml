<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - LibraryApp</title>
    <title>@ViewData["Title"] - LaboratoryApp</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
</head>

<body class="hold-transition sidebar-mini">

<div class="wrapper">
    
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
    <a href="/Index" class="brand-link">
        <span class="brand-text font-weight-light">EBS - Eğitim Bilgi Sistemi</span>
    </a>
    
    <div class="sidebar">
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                <li class="nav-item menu-open">
                    <a href="#" class="nav-link active">
                        <i class="nav-icon fas fa-book-reader"></i>
                        <p>
                            Kütüphane Sistemi
                            <i class="right fas fa-angle-left"></i>
                        </p>
                    </a>
                    
                    <ul class="nav nav-treeview">
                        
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-pen"></i>
                                <p>
                                    Yazar İşlemleri
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Authors/Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Yazarları Listele</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Authors/Create" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Yeni Yazar Ekle</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-book-open"></i>
                                <p>
                                    Kitap İşlemleri
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Books/Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Kitapları Listele</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Books/Create" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Yeni Kitap Ekle</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>
                                    Üye İşlemleri
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Members/Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Üyeleri Listele</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Members/Create" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Yeni Üye Ekle</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-table"></i>
                                <p>
                                    Kategori İşlemleri
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Categories/Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Kategorileri Listele</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Categories/Create" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Yeni Kategori Ekle</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-book"></i>
                                <p>
                                    Yayınevi İşlemleri
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Publishers/Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Yayınevlerini Listele</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Publishers/Create" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Yeni Yayınevi Ekle</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-exchange-alt"></i>
                                <p>
                                    Ödünç İşlemleri
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Loans/Create" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Yeni Kitap Ödünç Al</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Library" asp-page="/Loans/Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Ödünçleri Listele / İade</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </li>
                <li class="nav-item menu-open">
                    <a href="#" class="nav-link active">
                        <i class="nav-icon fas fa-laptop-code"></i>
                        <p>
                            Laboratuvar Sistemi
                            <i class="right fas fa-angle-left"></i>
                        </p>
                    </a>
                    
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a asp-area="Laboratory" asp-page="/Books/Index" class="nav-link">
                                <i class="nav-icon fas fa-book-open"></i>
                                <p>Kaynak Kitaplar</p>
                            </a>
                        </li>
                    </ul>
                    
                </li>
            </ul>
        </nav>
        
    </div>
</aside>
    
    <div class="content-wrapper">
        <section class="content p-3">
            @RenderBody()
        </section>
    </div>

    <footer class="main-footer">
        <strong>&copy; 2026 - LibraryApp</strong>
    </footer>
</div>

<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/dist/js/adminlte.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>