<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - LibraryApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Ee.Ebs.Web.Razor.Library.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-page="/Index">LibraryApp</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1"> 
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Authors/Index">Yazarlar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Books/Index">Kitaplar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/Members/Index">Üyeler</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="loanDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Ödünç Alma İşlemleri
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="loanDropdown">
                            <li>
                                <a class="dropdown-item" asp-page="/Loans/Create">
                                    <i class="bi bi-plus-circle text-success"></i> Yeni Kitap Ödünç Al
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-page="/Loans/Index">
                                    <i class="bi bi-arrow-return-left text-primary"></i> Kitap İade Et / Listele
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-bold" asp-page="/Categories/Index">Kategori İşlemleri</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-bold" asp-page="/Publishers/Index">Yayınevleri</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        <!-- MVC controller komutu Razor Pages ile değiştirildi -->
        &copy; 2026 - LibraryApp - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>