@model PublisherVm

@{
    ViewData["Title"] = "Yayınevi Sil";
}

<div class="container mt-4">
    <h2 class="text-danger">Yayınevi Silme Onayı</h2>
    <hr />
    
    <div class="alert alert-warning">
        <strong>@Model.Name</strong> adlı yayınevini silmek istediğinize emin misiniz?
    </div>

    <div class="card mt-4 mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Yayınevi Adı:</dt>
                <dd class="col-sm-9">@Model.Name</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Evet, Sil</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">İptal</a>
    </form>
</div>