@page
@model Ee.Ebs.Web.Razor.Laboratory.Areas.Laboratory.Pages.Books.IndexModel

<div class="container mt-4">
    <h2>Kitap Listesi</h2>
    <a asp-page="Create" class="btn btn-primary mb-3">Yeni Kitap Ekle</a>

    @if (Model.Books != null && Model.Books.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
            <tr>
                <th>İşlemler</th>
                <th>Kitap Adı</th>
                <th>Yayınlanma Yılı</th>
                <th>Yazarı</th>
                <th>Ödünç Alındı Mı?</th>
                <th>Kategori</th>
                <th>Yayınevi</th>
            </tr>
            </thead>
        <tbody>
                @foreach (var item in Model.Books)
                 {
                     <tr>
                         <td>
                             <div class="dropdown">
                                 <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" id="dropdownMenuButton_@item.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                     İşlemler
                                 </button>
        
                                 <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton_@item.Id">
                                     <li>
                                         <a class="dropdown-item text-primary" asp-page="Edit" asp-route-id="@item.Id">
                                             <i class="bi bi-pencil"></i> Güncelle
                                         </a>
                                     </li>
                                     <li>
                                         <hr class="dropdown-divider">
                                     </li>
                                     <li>
                                         <a class="dropdown-item text-danger" asp-page="Delete" asp-route-id="@item.Id">
                                             <i class="bi bi-trash"></i> Sil
                                         </a>
                                     </li>
                                 </ul>
                             </div>
                         </td>
                         <td>@item.Title</td>
                         <td>@item.PublishYear</td>
                         <td>@item.FullName</td>
                         <td>
                             @if(item.IsBorrowed)
                             {
                                 <span class="badge bg-warning text-dark">Evet</span>
                             }
                             else
                             {
                                 <span class="badge bg-success">Hayır</span>
                             }
                         </td>
                         <td>@item.CategoryName</td>
                         <td>@item.PublisherName</td>
                     </tr>
                 }
        </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Veritabanında henüz kayıtlı bir kitap bulunmuyor. Yukarıdaki butonu kullanarak ilk kaydı ekleyebilirsiniz.
        </div>
    }
</div>