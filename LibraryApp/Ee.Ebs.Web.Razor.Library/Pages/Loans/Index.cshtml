@page
@model Ee.Ebs.Web.Razor.Library.Pages.Loans.IndexModel

<div class="container mt-4">
    <h2>Ödünç Verilen Kitaplar</h2>
    <a asp-page="Create" class="btn btn-primary mb-3">Yeni Ödünç Ver</a>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Loans != null && Model.Loans.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>İşlemler</th>
                    <th>Üye Adı</th>
                    <th>Kitap Adı</th>
                    <th>Veriliş</th>
                    <th>Son Teslim</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Loans)
                {
                    <tr>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" id="dropdownMenuButton_@item.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                    İşlemler
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton_@item.Id">
                                    @if (!item.ReturnDate.HasValue)
                                    {
                                        <li>
                                            <a class="dropdown-item text-success" asp-page="./ReturnBook" asp-route-id="@item.Id">
                                                <i class="bi bi-box-arrow-in-down"></i> İade Al
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-page="Delete" asp-route-id="@item.Id">
                                            <i class="bi bi-trash"></i> Sil (İptal)
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                        <td>@item.FullName</td>
                        <td>@item.BookName</td>
                        <td>@item.LoanDate.ToShortDateString()</td>
                        <td>@item.DueDate.ToShortDateString()</td>
                        <td>
                            @if (item.ReturnDate.HasValue)
                            {
                                <span class="badge bg-success">İade Edildi</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Ödünçte</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Sistemde kayıtlı ödünç işlemi bulunmuyor.
        </div>
    }
</div>