@page "{id:int}"
@model Ee.Ebs.Web.Razor.Library.Pages.Publishers.EditModel

<div class="Güncelle">
    <h2>Yayınevi Güncelle</h2>
    <hr>

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <input type="hidden" asp-for="Vm.Id" />
                <div class="mb-3">
                    <label asp-for="Vm.Name" class="form-label">Yayınevi Adı</label>
                    <input asp-for="Vm.Name" class="form-control" autocomplete="off" required/>
                </div>

                <button type="submit" class="btn btn-success">Kaydet</button>
                <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Listeye Dön</a>
            </form>

        </div>
    </div>

</div>