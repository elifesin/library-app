@page
@model Ee.Ebs.Web.Razor.Library.Pages.Publishers.IndexModel

<div class="container mt-4">
    <h2>Yayınevi Listesi</h2>
    <a asp-page="Create" class="btn btn-primary mb-3">Yeni Yayınevi Ekle</a>

    @if (Model.Vm != null && Model.Vm.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
            <tr>
                <th>İşlemler</th>
                <th>Yayınevi</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Vm)
            {
                <tr>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle btn-sm" type="button" id="dropdownMenuButton_@item.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                İşlemler
                            </button>
        
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton_@item.Id">
                                <li>
                                    <a class="dropdown-item text-primary" asp-page="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil"></i> Güncelle
                                    </a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-page="Delete" asp-route-id="@item.Id">
                                        <i class="bi bi-trash"></i> Sil
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </td>
                    <td>@item.Name</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Veritabanında henüz kayıtlı bir yazar bulunmuyor. Yukarıdaki butonu kullanarak ilk kaydı ekleyebilirsiniz.
        </div>
    }
</div>
