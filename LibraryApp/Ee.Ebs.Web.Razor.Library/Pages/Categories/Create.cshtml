@page
@model Ee.Ebs.Web.Razor.Library.Pages.Categories.CreateModel

<div class="container mt-4">
    <h2>Yeni Kategori Ekle</h2>
    <hr>

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Vm.CategoryName" class="form-label">Kategori</label>
                    <input asp-for="Vm.CategoryName" class="form-control" autocomplete="off" required/>
                </div>
                <button type="submit" class="btn btn-success">Kaydet</button>
                <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Listeye Dön</a>
            </form>
        </div>
    </div>
</div>