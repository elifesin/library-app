@page "{id:int}"
@model Ee.Ebs.Web.Razor.Library.Pages.Books.EditModel

<div class="container mt-4">
    <h2>Kitabı Güncelle</h2>
    <hr />
    
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <input type="hidden" asp-for="Vm.Id" />

                <div class="mb-3">
                    <label asp-for="Vm.Title" class="form-label">Kitap Adı</label>
                    <input asp-for="Vm.Title" class="form-control" placeholder="Kitap adını giriniz..." />
                    <span asp-validation-for="Vm.Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Vm.AuthorID" class="form-label">Yazar</label>
                    <select asp-for="Vm.AuthorID" class="form-select" asp-items="@(new SelectList(Model.Authors, "Id", "FullName"))">
                        <option value="">-- Yazar Seçiniz --</option>
                    </select>
                    <span asp-validation-for="Vm.AuthorID" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Vm.PublishYear" class="form-label">Yayınlanma Yılı</label>
                    <input asp-for="Vm.PublishYear" class="form-control" placeholder="Yayın yılını giriniz..." />
                    <span asp-validation-for="Vm.PublishYear" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Vm.CategoryID" class="form-label">Kategori</label>
                    <select asp-for="Vm.CategoryID" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "CategoryName"))">
                        <option value="">-- Kategori Seçiniz --</option>
                    </select>
                    <span asp-validation-for="Vm.CategoryID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Vm.PublisherId" class="form-label">Yayınevi</label>
                    <select asp-for="Vm.PublisherId" class="form-select" asp-items="@(new SelectList(Model.Publishers, "Id", "Name"))">
                        <option value="">-- Yayınevi Seçiniz --</option>
                    </select>
                    <span asp-validation-for="Vm.PublisherId" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Vm.IsBorrowed" class="form-check-input" />
                    <label asp-for="Vm.IsBorrowed" class="form-check-label">Ödünç Alındı Mı?</label>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Değişiklikleri Kaydet
                    </button>
                    <a asp-page="./Index" class="btn btn-secondary ms-2">İptal ve Listeye Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>