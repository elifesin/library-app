@page "{id:int}"
@model Ee.Ebs.Web.Razor.Library.Areas.Library.Pages.Authors.DeleteModel

@{
    ViewBag.CurrentPage = LibraryPageNames.AuthorsDelete;
}

<div class="container mt-4">
    <h2 class="text-danger">Yazarı Sil</h2>

    <div class="alert alert-warning mt-3" role="alert">
        <h4 class="alert-heading">Dikkat!</h4>
        <p><strong>@Model.Vm.FullName</strong> isimli yazarı silmek üzeresiniz.</p>
        <hr>
        <p class="mb-0">Bu işlemi onaylarsanız, yazar sistemden kalıcı olarak silinecektir. Devam etmek istediğinize emin misiniz?</p>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Yazar Detayları</h5>
            <dl class="row mt-3">
                <dt class="col-sm-3">Adı</dt>
                <dd class="col-sm-9">@Model.Vm.FirstName</dd>

                <dt class="col-sm-3">Soyadı</dt>
                <dd class="col-sm-9">@Model.Vm.LastName</dd>

                <dt class="col-sm-3">Durum</dt>
                <dd class="col-sm-9">
                    @if (Model.Vm.IsActive)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <form method="post">
            <!-- Arka plandaki OnPost(int id) metoduna id parametresini route üzerinden veya bu hidden input ile güvenle geçebiliriz -->
            <input type="hidden" asp-for="Vm.Id" />
            
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Evet, Kalıcı Olarak Sil
            </button>
            <a asp-page="./Index" class="btn btn-secondary ms-2">İptal ve Listeye Dön</a>
        </form>
    </div>
</div>