@page
@model Ee.Ebs.Web.Razor.Library.Areas.Library.Pages.Categories.DeleteModel

<div class="container mt-4">
    <h2 class="text-danger">Yazarı Sil</h2>

    <div class="alert alert-warning mt-3" role="alert">
        <h4 class="alert-heading">Dikkat!</h4>
        <p><strong>@Model.Vm.CategoryName</strong> adlı kategoriyi silmek üzeresiniz.</p>
        <hr>
        <p class="mb-0">Bu işlemi onaylarsanız, kategori sistemden kalıcı olarak silinecektir. Devam etmek istediğinize emin misiniz?</p>
    </div>

    <div class="mt-4">
        <form method="post">
            <input type="hidden" asp-for="Vm.Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Evet, Kalıcı Olarak Sil
            </button>
            <a asp-page="./Index" class="btn btn-secondary ms-2">İptal ve Listeye Dön</a>
        </form>
    </div>
</div>