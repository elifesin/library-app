@page
@model Ee.Ebs.Web.Razor.Library.Areas.Library.Pages.Publishers.CreateModel

<div class="container mt-4">
    <h2>Yeni Yayınevi Ekle</h2>
    <hr>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Vm.Name" class="form-label">Yayınevi</label>
                    <input asp-for="Vm.Name" class="form-control" autocomplete="off" required/>
                </div>
                <button type="submit" class="btn btn-success">Kaydet</button>
                <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Listeye Dön</a>
            </form>
        </div>
    </div>
</div>