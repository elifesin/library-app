@page
@model Ee.Ebs.Web.Razor.Library.Areas.Library.Pages.Members.CreateModel

<div class="container mt-4">
    <h2>Yeni Üye Ekle</h2>
    <hr />
    
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Vm.FirstName" class="form-label">Ad</label>
                    <input asp-for="Vm.FirstName" class="form-control" />
                    <span asp-validation-for="Vm.FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Vm.LastName" class="form-label">Soyad</label>
                    <input asp-for="Vm.LastName" class="form-control" />
                    <span asp-validation-for="Vm.LastName" class="text-danger"></span>
                </div>
                
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Kaydet
                    </button>
                    <a asp-page="./Index" class="btn btn-secondary ms-2">Listeye Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>