@page "{id:int}"
@model Ee.Ebs.Web.Razor.Library.Areas.Library.Pages.Books.DeleteModel

@{
    ViewBag.CurrentPage = LibraryPageNames.BooksDelete;
}

<div class="container mt-4">
    <h2 class="text-danger">Kitabı Sil</h2>

    <div class="alert alert-warning mt-3" role="alert">
        <h4 class="alert-heading">Dikkat!</h4>
        <p><strong>@Model.Vm.Title</strong> adlı kitabı silmek üzeresiniz.</p>
        <hr>
        <p class="mb-0">Bu işlemi onaylarsanız, kitap sistemden kalıcı olarak silinecektir. Devam etmek istediğinize emin misiniz?</p>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Kitap Detayları</h5>
            <dl class="row mt-3">
                <dt class="col-sm-3">Kitap Adı</dt>
                <dd class="col-sm-9">@Model.Vm.Title</dd>

                <dt class="col-sm-3">Yazarı</dt>
                <dd class="col-sm-9">@Model.Vm.AuthorName</dd>

                <dt class="col-sm-3">Kategori</dt>
                <dd class="col-sm-9">@Model.Vm.CategoryName</dd>

                <dt class="col-sm-3">Yayınevi</dt>
                <dd class="col-sm-9">@Model.Vm.PublisherName</dd>

                <dt class="col-sm-3">Durum</dt>
                <dd class="col-sm-9">
                    @if (Model.Vm.IsBorrowed)
                    {
                        <span class="badge bg-warning text-dark">Ödünç Alındı</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Rafta</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <form method="post">
            <!-- Arka plandaki OnPost metoduna ID'yi güvenle iletmek için -->
            <input type="hidden" asp-for="Vm.Id" />
            
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Evet, Kalıcı Olarak Sil
            </button>
            <a asp-page="./Index" class="btn btn-secondary ms-2">İptal ve Listeye Dön</a>
        </form>
    </div>
</div>