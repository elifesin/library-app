@model Ee.Ebs.LibraryApp.Models.Members.MemberBorrowedBooksVm

@{
    ViewData["Title"] = "Ödünç Alınan Kitaplar";
}

<h2>@Model.FullName Adlı Üyenin Ödünç Aldığı Kitaplar</h2>

<hr />

<table class="table table-striped">
    <thead>
    <tr>
        <th>Kitap Adı</th>
        <th>Alış Tarihi</th>
        <th>Son Teslim Tarihi</th>
        <th>Teslim Ettiği Tarih</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.BorrowedBooks)
    {
        <tr>
            <td>@item.BookName</td>
            <td>@item.LoanDate.ToShortDateString()</td>
            <td>@item.DueDate.ToShortDateString()</td>
            <td>
                @if (item.ReturnDate == null || item.ReturnDate == default(DateTime))
                {
                    <span class="badge bg-secondary">İade Edilmedi</span>
                }
                else
                {
                    @item.ReturnDate.ToShortDateString()
                    
                }
            </td>
        </tr>
    }
    </tbody>
</table>