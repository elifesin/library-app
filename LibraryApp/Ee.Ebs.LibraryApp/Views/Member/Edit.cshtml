@model Ee.Ebs.LibraryApp.Models.Members.MemberVm

<div class="Güncelle">
    <h2>Üye Bilgisi Güncelle</h2>
    <hr>
    
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="ID" />
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">Üye Adı</label>
                    <input asp-for="FirstName" class="form-control" autocomplete="off" required/>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">Üye Soyadı</label>
                    <input asp-for="LastName" class="form-control" autocomplete="off" required/>
                </div>

                <button type="submit" class="btn btn-success">Kaydet</button>
                <a asp-controller="Member" asp-action="Index" class="btn btn-outline-secondary ms-2">Listeye Dön</a>
            </form>
        </div>
    </div>
    
</div>