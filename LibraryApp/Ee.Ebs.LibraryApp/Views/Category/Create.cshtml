@model Ee.Ebs.LibraryApp.Models.Category.CategoryVm

<div class="container mt-4">
    <h2>Yeni Kategori Ekle</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label">Kategori Adı</label>
                    <input asp-for="CategoryName" class="form-control" autocomplete="off" required />
                </div>
                
                <button type="submit" class="btn btn-success">Kaydet</button>
                <a asp-controller = "Category" asp-action="Index" class="btn btn-outline-secondary ms-2">Listeye Dön</a>
            </form>
        </div>
    </div>
</div>