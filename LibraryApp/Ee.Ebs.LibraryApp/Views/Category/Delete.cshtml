@model Ee.Ebs.LibraryApp.Models.Category.CategoryVm

<div class="container mt-4">
    <h2 class="text-danger">Kategori Silinecek!</h2>
    <hr />
    
    <div class="alert alert-danger">
        <strong>Dikkat!</strong> 
        @Model.CategoryName adlı kategoriyi kalıcı olarak silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
    
        <button type="submit" class="btn btn-danger">Evet, Kalıcı Olarak Sil</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">İptal ve Listeye Dön</a>
    </form>
</div>