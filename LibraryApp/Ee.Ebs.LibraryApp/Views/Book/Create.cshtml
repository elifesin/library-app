@model Ee.Ebs.LibraryApp.Models.Book.BookCreateVm

<div class="container mt-4">
    <h2>Yeni Kitap Ekle</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Kitap Adı</label>
                    <input asp-for="Title" class="form-control" autocomplete="off" required />
                </div>
                
                <div class="mb-3">
                    <label asp-for="PublishYear" class="form-label">Yayınlanma Yılı </label>
                    <input asp-for="PublishYear" class="form-control" autocomplete="off" required />
                </div>
                <div class="mb-3">
                    <label asp-for="PublisherId" class="form-label">Yayınevi</label>
                    <select asp-for="PublisherId" class="form-select" asp-items="@(new SelectList(ViewBag.Publishers, "Id", "Name"))">
                        <option value="">-- Yayınevi Seçiniz --</option>
                    </select>
                    <span asp-validation-for="PublisherId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="AuthorID" class="form-label">Yazar</label>
                    <select asp-for="AuthorID" class="form-control" required>
                        <option value="">Yazar Seçiniz</option>
                        @foreach (var author in ViewBag.Authors)
                        {
                            <option value="@author.Id">
                                @author.FullName
                            </option>
                        }
                    </select>
                </div>
                
                <div class="mb-3">
                    <label asp-for="CategoryID" class="form-label">Kategori</label>
                    <select asp-for="CategoryID" class="form-select">
                        <option value="">-- Kategori Seçiniz --</option>
                        @if(ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Id">@category.CategoryName</option>
                            }
                        }
                    </select>
                </div>
                
                
                <button type="submit" class="btn btn-success">Kaydet</button>
                <a asp-controller="Book" asp-action="Index" class="btn btn-outline-secondary ms-2">Listeye Dön</a>
            </form>
        </div>
    </div>
</div>